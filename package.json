{
  "name": "@proxygate/sdk",
  "version": "0.14.1",
  "description": "Proxygate SDK — typed client for the Proxygate agent marketplace. Buy APIs, sell capacity, and tunnel agents. USDC on Solana.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "proxygate",
    "api",
    "proxy",
    "solana",
    "usdc",
    "ai",
    "marketplace",
    "sdk"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/proxygate-official/sdk"
  },
  "homepage": "https://proxygate.ai",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "gen:types": "openapi-typescript ../../apps/gateway/openapi.generated.json -o src/generated/gateway.ts",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "tweetnacl": "^1.0.3"
  },
  "peerDependencies": {
    "@solana/spl-token": "^0.4.0",
    "@solana/web3.js": "^1.90.0"
  },
  "peerDependenciesMeta": {
    "@solana/web3.js": {
      "optional": true
    },
    "@solana/spl-token": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@proxygate/api-types": "workspace:*",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  }
}
